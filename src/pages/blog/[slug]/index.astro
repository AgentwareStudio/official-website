---
import Page from '../../../layouts/Page.astro';
import BlogPost from '../../../blog/BlogPost.astro';
import { postMeta } from '../../../blog/pages';
import { postData } from '../../../blog/routes';

export const prerender = false;
const data = await postData('en', Astro.params.slug);
if (!data) return new Response(null, { status: 404 });
---
<Page page="post" code="en" blog={postMeta(data.post, data.others)}><BlogPost {...data} /></Page>
