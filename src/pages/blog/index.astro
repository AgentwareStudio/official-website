---
import Page from '../../layouts/Page.astro';
import BlogIndex from '../../blog/BlogIndex.astro';
import { indexMeta } from '../../blog/pages';
import { indexData } from '../../blog/routes';

export const prerender = false;
const posts = await indexData('en');
---
<Page page="blog" code="en" blog={indexMeta('en')}><BlogIndex lang="en" posts={posts} /></Page>
