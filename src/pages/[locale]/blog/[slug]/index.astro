---
import Page from '../../../../layouts/Page.astro';
import BlogPost from '../../../../blog/BlogPost.astro';
import { postMeta } from '../../../../blog/pages';
import { allPosts, translations } from '../../../../blog/source';
import { BLOG_LANGS } from '../../../../blog/types';

export async function getStaticPaths() {
  return (await allPosts()).filter((p) => p.lang !== 'en').map((post) => ({ params: { locale: post.lang, slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const others = await translations(post);
---
<Page page="post" code={BLOG_LANGS[post.lang].locale} blog={postMeta(post, others)}><BlogPost post={post} others={others} /></Page>
