---
import Page from '../../../../layouts/Page.astro';
import BlogPost from '../../../../blog/BlogPost.astro';
import { postMeta } from '../../../../blog/pages';
import { blogLang, postData } from '../../../../blog/routes';
import { BLOG_LANGS } from '../../../../blog/types';

export const prerender = false;
const lang = blogLang(Astro.params.locale);
const data = lang && (await postData(lang, Astro.params.slug));
if (!lang || !data) return new Response(null, { status: 404 });
---
<Page page="post" code={BLOG_LANGS[lang].locale} blog={postMeta(data.post, data.others)}><BlogPost {...data} /></Page>
