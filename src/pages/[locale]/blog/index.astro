---
import Page from '../../../layouts/Page.astro';
import BlogIndex from '../../../blog/BlogIndex.astro';
import { indexMeta } from '../../../blog/pages';
import { listPosts } from '../../../blog/source';
import { BLOG_LANGS, type BlogLang } from '../../../blog/types';

export function getStaticPaths() {
  return (['zh', 'ja'] as BlogLang[]).map((lang) => ({ params: { locale: lang }, props: { lang } }));
}
const { lang } = Astro.props;
const posts = await listPosts(lang);
---
<Page page="blog" code={BLOG_LANGS[lang].locale} blog={indexMeta(lang)}><BlogIndex lang={lang} posts={posts} /></Page>
