---
import Page from '../../../layouts/Page.astro';
import BlogIndex from '../../../blog/BlogIndex.astro';
import { indexMeta } from '../../../blog/pages';
import { blogLang, indexData } from '../../../blog/routes';
import { BLOG_LANGS } from '../../../blog/types';

export const prerender = false;
const lang = blogLang(Astro.params.locale);
if (!lang) return new Response(null, { status: 404 });
const posts = await indexData(lang);
---
<Page page="blog" code={BLOG_LANGS[lang].locale} blog={indexMeta(lang)}><BlogIndex lang={lang} posts={posts} /></Page>
