---
// One post. A dark title block with a spec row, the cover in a frame, then the text on a paper sheet with the
// contents rail beside it. Reading is the run: the rail tracks progress and the mark's outcome point lights at the end.
import './blog.css';
import BlogMark from './BlogMark.astro';
import Cover from './Cover.astro';
import { BLOG_UI, LANG_LABEL, dotted, readingMinutes } from './strings';
import { headings } from './pages';
import { blogIndex, postPath, type Post } from './types';
/** `list`: every post in this language, newest first (for the number and the previous/next links). */
interface Props { post: Post; others: Post[]; list: Post[] }
const { post, others, list } = Astro.props;
const ui = BLOG_UI[post.lang];
const toc = headings(post.body_html);
let n2 = 0;
const tocItems = toc.map((h) => ({ ...h, no: h.level === 2 ? String(++n2).padStart(2, '0') : '' }));
const edited = post.updated_at.getTime() - post.publish_at.getTime() > 86_400_000;
const at = list.findIndex((p) => p.id === post.id);
const no = String(list.length - at).padStart(2, '0');
const newer = at > 0 ? list[at - 1] : null;
const older = at >= 0 && at < list.length - 1 ? list[at + 1] : null;
---
<article class="bp" lang={post.lang === 'zh' ? 'zh-CN' : post.lang}>
  <div class="bp-bar" aria-hidden="true"><i></i></div>
  <header class="bp-head">
    <div class="wrap bp-head__grid">
      <p class="eyebrow bp-crumb">
        <a href={blogIndex(post.lang)}><BlogMark size={14} /> {ui.en}</a>
        <span aria-hidden="true">//</span><span>N° {no}</span>
        {post.tags.map((t) => <><span aria-hidden="true">·</span><a class="bp-crumb__tag" href={`${blogIndex(post.lang)}?tag=${encodeURIComponent(t)}`}>{t}</a></>)}
      </p>
      <h1 class="bp-title">{post.title}</h1>
      <p class="bp-summary">{post.summary}</p>
      <dl class="bp-spec">
        <div>
          <dt class="mono">{ui.published}</dt>
          <dd><time datetime={post.publish_at.toISOString()}>{ui.date(post.publish_at)}</time></dd>
        </div>
        {edited && (
          <div>
            <dt class="mono">{ui.updated}</dt>
            <dd><time datetime={post.updated_at.toISOString()}>{ui.date(post.updated_at)}</time></dd>
          </div>
        )}
        <div>
          <dt class="mono">{ui.reading}</dt>
          <dd>{ui.minutes(readingMinutes(post.lang, post.body_html))}</dd>
        </div>
        {others.length > 0 && (
          <div>
            <dt class="mono">{ui.alsoIn}</dt>
            <dd class="bp-spec__langs">
              {others.map((o) => <a href={postPath(o.lang, o.slug)} hreflang={o.lang} lang={o.lang}>{LANG_LABEL[o.lang]}</a>)}
            </dd>
          </div>
        )}
      </dl>
    </div>
  </header>

  {post.cover && (
    <div class="wrap bp-cover">
      <div class="bi-frame bi-frame--still">
        <span class="bi-frame__c" aria-hidden="true"></span>
        <div class="bi-frame__img"><Cover cover={post.cover} eager /></div>
      </div>
    </div>
  )}

  <div class:list={['bp-sheet', { 'bp-sheet--cover': post.cover }]}>
    <div class="wrap bp-sheet__grid">
      {tocItems.length > 1 && (
        <nav class="bp-rail" aria-label={ui.contents}>
          <details class="bp-toc" open>
            <summary class="bp-toc__title mono"><span>{ui.contents}</span><span class="bp-toc__pct" aria-hidden="true">00%</span></summary>
            <ol>
              {tocItems.map((h) => (
                <li class={`lvl-${h.level}`}>
                  <a href={`#${h.id}`}>{h.no && <span class="mono">{h.no}</span>}<span>{h.text}</span></a>
                </li>
              ))}
            </ol>
          </details>
        </nav>
      )}
      <div class="bp-main">
        <div class="prose" set:html={post.body_html} />
        <footer class="bp-end">
          <BlogMark size={44} class="bp-end__mark" />
          <div>
            <p class="bp-end__label mono">{ui.end} <span>// Delivered</span></p>
            <p class="bp-end__note">{ui.endNote}</p>
          </div>
          <a class="bp-end__top mono" href="#main">{ui.toTop} ↑</a>
        </footer>
      </div>
    </div>
  </div>

  <nav class="bp-pager" aria-label={ui.archive}>
    <div class="wrap bp-pager__grid">
      {older ? (
        <a class="bp-pager__item" href={postPath(older.lang, older.slug)} rel="prev">
          <span class="bp-pager__dir mono">← {ui.prev}</span>
          <span class="bp-pager__title">{older.title}</span>
          <time class="bp-pager__date mono" datetime={older.publish_at.toISOString()}>{dotted(older.publish_at)}</time>
        </a>
      ) : <span class="bp-pager__item is-empty" aria-hidden="true"></span>}
      {newer ? (
        <a class="bp-pager__item bp-pager__item--next" href={postPath(newer.lang, newer.slug)} rel="next">
          <span class="bp-pager__dir mono">{ui.next} →</span>
          <span class="bp-pager__title">{newer.title}</span>
          <time class="bp-pager__date mono" datetime={newer.publish_at.toISOString()}>{dotted(newer.publish_at)}</time>
        </a>
      ) : <span class="bp-pager__item is-empty" aria-hidden="true"></span>}
      <a class="bp-pager__all link-arrow" href={blogIndex(post.lang)}>{ui.back} <span aria-hidden="true">→</span></a>
    </div>
  </nav>
</article>

<script>
  // Reading as a run: progress on the rail and the top bar, the current heading, copy buttons on code,
  // and the outcome point that lights once the end of the text is reached.
  const root = document.querySelector<HTMLElement>('.bp');
  const main = document.querySelector<HTMLElement>('.bp-main');
  const pct = document.querySelector<HTMLElement>('.bp-toc__pct');
  const toc = document.querySelector<HTMLDetailsElement>('.bp-toc');
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('.bp-toc a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  const heads = [...links.keys()].map((id) => document.getElementById(id)).filter((h): h is HTMLElement => !!h);
  const end = document.querySelector<HTMLElement>('.bp-end');

  // The contents start closed on narrow screens, where they sit above the text.
  const narrow = matchMedia('(max-width: 1023px)');
  if (toc && narrow.matches) toc.open = false;

  let ticking = false;
  const update = () => {
    ticking = false;
    if (!main || !root) return;
    const r = main.getBoundingClientRect();
    const done = Math.min(1, Math.max(0, (innerHeight * 0.5 - r.top) / Math.max(1, r.height)));
    root.style.setProperty('--read', done.toFixed(4));
    if (pct) pct.textContent = `${String(Math.round(done * 100)).padStart(2, '0')}%`;
    let current = '';
    for (const h of heads) if (h.getBoundingClientRect().top < innerHeight * 0.32) current = h.id;
    links.forEach((a, id) => {
      if (id === current) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update, { passive: true });
  update();

  if (end && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { end.classList.add('is-lit'); root?.classList.add('is-done'); io.disconnect(); }
    }, { threshold: 0.6 });
    io.observe(end);
  }

  // Close the contents after a jump on narrow screens.
  links.forEach((a) => a.addEventListener('click', () => { if (toc && narrow.matches) toc.open = false; }));

  // Code blocks get a title bar: the language and a copy button.
  const labels = document.querySelector<HTMLElement>('[data-copy-labels]')?.dataset;
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const box = document.createElement('div');
    box.className = 'code';
    const bar = document.createElement('div');
    bar.className = 'code__bar mono';
    const lang = document.createElement('span');
    lang.textContent = pre.dataset.lang ?? 'text';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'code__copy';
    btn.textContent = labels?.copy ?? 'Copy';
    bar.append(lang, btn);
    pre.replaceWith(box);
    box.append(bar, pre);
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? pre.textContent ?? '');
        btn.textContent = labels?.copied ?? 'Copied';
        btn.classList.add('is-done');
        setTimeout(() => { btn.textContent = labels?.copy ?? 'Copy'; btn.classList.remove('is-done'); }, 1600);
      } catch { /* clipboard unavailable: leave the label */ }
    });
  });
</script>
<span hidden data-copy-labels data-copy={ui.copy} data-copied={ui.copied}></span>
