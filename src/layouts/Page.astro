---
// Every page in every locale: title, description, canonical/hreflang, icons and font preloads in <head>; the body is
// one React island rendered at build time (copy in the HTML) and hydrated in the browser. Blog pages pass their own
// title, URLs and language versions, and their content as the island's slot; product pages pass theirs as `doc`.
import '../styles.css';
import BlogSite from '../site/BlogSite';
import HomeSite from '../site/HomeSite';
import LearnSite from '../site/LearnSite';
import NotFoundSite from '../site/NotFoundSite';
import ProductSite from '../site/ProductSite';
import ProductsSite from '../site/ProductsSite';
import StartSite from '../site/StartSite';
import { NEWSLETTER } from '../newsletter/strings';
import { LOCALES, messagesFor, type Locale } from '../i18n';
import { SITE, pageAlternates, pageMeta, pageSub, pageUrl, type Page, type SitePage } from '../meta';
import { markdownPath } from '../markdown';
import { jsonLd } from '../structured';
import type { Alternates } from '../components/Chrome';
import type { Doc } from '../products/pages';
import faviconSvg from '../assets/brand/agentware_favicon_dark.svg?url';
import favicon32 from '../assets/brand/agentware_favicon_dark_32.png?url';
import appleIcon from '../assets/brand/agentware_icon_app_dark_180.png?url';
import inter from '../assets/fonts/inter.woff2?url';
import sansSc from '../assets/fonts/aw-sans-sc.woff2?url';
import sansJp from '../assets/fonts/aw-sans-jp.woff2?url';
import sansKr from '../assets/fonts/aw-sans-kr.woff2?url';

interface Props {
  page: Page;
  code: Locale;
  /** Blog pages: title, description, the page's path, its language versions (paths, this page included), its feed
   *  and (posts) their structured data. */
  blog?: { title: string; description: string; path: string; alternates: Alternates; rss: string; graph?: object[] };
  /** Product pages (src/products/pages.ts): the same, without a feed. */
  doc?: Doc;
}
const { page, code, blog, doc } = Astro.props;
// A page that brings its own head: its language versions are the ones it lists.
const own = blog ?? doc;
const FONT: Partial<Record<Locale, string>> = { 'zh-CN': sansSc, ja: sansJp, ko: sansKr };

const messages = await messagesFor(code);
const { title, description } = own ?? pageMeta(page as SitePage, code, messages);
const ownVersions = own ? (Object.entries(own.alternates) as [Locale, string][]) : [];
const sub = pageSub(page);
// Pages for people, not search: the 404 page and the newsletter's confirmation page (reached from an email only).
const unlisted = page === 'notfound' || page === 'confirm';
const url = (path: string) => pageUrl(path, sub);
const self = LOCALES.find((l) => l.code === code)!;
// The page's Markdown version (src/markdown.ts) for agents; the 404 page has none.
const markdown = unlisted ? null : SITE + markdownPath(own?.path ?? url(self.path).slice(SITE.length));

// Root home page only: on the first visit go to the browser's language (kept as aw-auto, so later visits to / land
// in the same place); a language picked in the menu or the hint (aw-lang) always wins.
// Crawlers and automation are left on the page so the English root stays indexable.
const redirect = page === 'home' && !self.path;
---
<!doctype html>
<html lang={code} class={page === 'home' ? 'snap' : undefined} data-blog-mode={blog ? 'dark' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07080C" />
    <meta name="color-scheme" content={blog ? 'dark light' : 'dark'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {unlisted ? (
      <meta name="robots" content="noindex" />
    ) : own ? (
      <>
        <link rel="canonical" href={SITE + own.path} />
        {ownVersions.map(([c, path]) => <link rel="alternate" hreflang={c} href={SITE + path} />)}
        {own.alternates.en && <link rel="alternate" hreflang="x-default" href={SITE + own.alternates.en} />}
        {blog && <link rel="alternate" type="application/rss+xml" title={blog.title} href={SITE + blog.rss} />}
      </>
    ) : (
      <>
        <link rel="canonical" href={url(self.path)} />
        {pageAlternates(sub).map((c) => <link rel="alternate" hreflang={c} href={url(LOCALES.find((l) => l.code === c)!.path)} />)}
        <link rel="alternate" hreflang="x-default" href={url('')} />
      </>
    )}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    {markdown && <link rel="describedby" type="text/plain" href={`${SITE}/llms.txt`} />}
    {!unlisted && <script is:inline type="application/ld+json" set:html={jsonLd(own?.graph)} />}
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32} />
    <link rel="apple-touch-icon" href={appleIcon} />
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
    {FONT[code] && <link rel="preload" href={FONT[code]} as="font" type="font/woff2" crossorigin />}
    {redirect && (
      <script is:inline>(function(){try{
      var ua=navigator.userAgent||'';if(navigator.webdriver||/bot|crawl|spider|slurp|preview|lighthouse|headless/i.test(ua))return;
      var P={'en':'','zh-CN':'zh','ja':'ja','ko':'ko','es':'es','fr':'fr','de':'de','pt-BR':'pt-br'};
      var ls=window.localStorage,pick=ls.getItem('aw-lang'),seen=ls.getItem('aw-seen');ls.setItem('aw-seen','1');
      if(!pick&&seen)pick=ls.getItem('aw-auto');
      if(!pick){if(seen)return;var L=navigator.languages&&navigator.languages.length?navigator.languages:[navigator.language||''];
        pick='en';for(var i=0;i<L.length;i++){var t=String(L[i]).toLowerCase(),b=t.split('-')[0];
          if(b==='zh'){pick='zh-CN';break}if(b==='pt'){pick='pt-BR';break}if(/^(en|ja|ko|es|fr|de)$/.test(b)){pick=b;break}}ls.setItem('aw-auto',pick)}
      var path=P[pick];if(path)location.replace('/'+path+'/'+location.search+location.hash);
    }catch(e){}})();</script>
    )}
    {blog && (
      // Blog pages, before the first paint: the reader's choice (Chrome.tsx ThemeButton), else the system setting.
      <script is:inline>try{var r=document.documentElement,c=localStorage.getItem('aw-blog-theme');r.dataset.blogMode=c==='paper'||c==='dark'?c:matchMedia('(prefers-color-scheme: light)').matches?'paper':'dark';if(r.dataset.blogMode==='paper')document.querySelector('meta[name="theme-color"]').setAttribute('content','#F4F3EF')}catch(e){}</script>
    )}
    <script is:inline>try{document.documentElement.classList.add('js');if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('reveal-pending')}catch(e){}</script>
  </head>
  <body data-page={page} data-locale={page === 'notfound' ? undefined : code}>
    <div id="root">
      {page === 'home' && <HomeSite client:load code={code} messages={messages} />}
      {page === 'learn' && <LearnSite client:load code={code} messages={messages} />}
      {page === 'notfound' && <NotFoundSite client:only="react" />}
      {(page === 'start' || page === 'confirm') && <StartSite client:load page={page} code={code} messages={messages} nl={NEWSLETTER[code]} />}
      {page === 'products' && doc && <ProductsSite client:load code={code} messages={messages} alternates={doc.alternates} />}
      {page === 'product' && doc && <ProductSite client:load code={code} messages={messages} alternates={doc.alternates} slug={Astro.params.slug!} />}
      {(page === 'blog' || page === 'post') && (
        <BlogSite client:load page={page} code={code} messages={messages} alternates={blog?.alternates}><slot /></BlogSite>
      )}
    </div>
  </body>
</html>
